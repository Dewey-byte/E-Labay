rules_version = '2';

// E-Labay Cloud Storage security rules.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }
    function isCollector() {
      return signedIn() && request.auth.token.role == 'collector';
    }
    function isImageUnder(megabytes) {
      return request.resource.size < megabytes * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Collection evidence photos: uploaded by Collectors, visible to Collectors
    // and to the office the collection belongs to. Evidence is immutable.
    match /collections/{officeId}/{scheduleId}/{fileName} {
      allow read: if isCollector()
        || (signedIn() && request.auth.token.officeId == officeId);
      allow create: if isCollector() && isImageUnder(5);
      allow update, delete: if false;
    }

    // Profile photos: owner writes, any signed-in user reads.
    match /profile_images/{uid}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && isImageUnder(2);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
